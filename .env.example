# TripCraft / PackagePro Environment Variables
# Copy to .env and replace placeholder values

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_PATH=./data/PS-04.db

# AI - Google Gemini API Key
# Models used: gemini-2.5-flash, gemini-1.5-flash, gemini-3.8-flash (with automatic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Real-World Hotels - SerpAPI Google Hotels Engine (200 requests/month quota)
SERPAPI_API_KEY=your_serpapi_key_here

# Real-World Tourist Attractions - OpenTripMap API (5,000 requests/day quota)
OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# Translation - LibreTranslate (Self-hosted or remote)
LIBRETRANSLATE_URL=http://localhost:5000
