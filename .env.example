# TripCraft / PackagePro Environment Variables
# Copy to .env and replace placeholder values

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_PATH=./data/PS-04.db

# AI - Google Gemini API Key
# Models used: gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash, gemini-3.5-flash (with cascade)
GEMINI_API_KEY=your_gemini_api_key_here

# Real-World Hotels - SerpAPI Google Hotels Engine (200 requests/month quota)
SERPAPI_API_KEY=your_serpapi_key_here

# Real-World Tourist Attractions - OpenTripMap API (5,000 requests/day quota)
OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# Microsoft Azure Translator API (Supports Tamil, Hindi, Telugu, Kannada, Marathi, Bengali, etc.)
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastasia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
